{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "DBunny",
  "mainBinaryName": "DBunny",
  "version": "0.7.0",
  "identifier": "com.dbunny.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build --workspace=web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBunny",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 23 },
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "visible": false,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "opener": {},
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQkUyMkNDNDA1RjcxODAKUldTQWNWOUF6Q0srSzY0aGY2NlpLVUxqbHBnWlFBWFc3S0lIelU3amMzRkw4WU5WSXpMaUpnKzEK",
      "endpoints": [
        "https://github.com/coelhomarcus/dbunny/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
