[
  {"name": "length", "signature": "length(text) → integer", "category": "text", "example": "SELECT length('abc')"},
  {"name": "lower", "signature": "lower(text) → text", "category": "text", "example": "SELECT lower('ABC')"},
  {"name": "upper", "signature": "upper(text) → text", "category": "text", "example": "SELECT upper('abc')"},
  {"name": "initcap", "signature": "initcap(text) → text", "category": "text", "example": "SELECT initcap('hello world')"},
